{
  "name": "amica-personas-contracts",
  "private": true,
  "version": "1.0.0",
  "description": "Amica Personas Smart Contracts",
  "scripts": {
    "test": "forge test",
    "test:coverage": "forge coverage --report lcov && mkdir -p test-results && forge test --junit > test-results/junit.xml",
    "slither": "slither . --config-file .slither.config.json",
    "slither:all": "slither . --exclude-low=false --exclude-informational=false",
    "slither:quick": "slither . --exclude-low --exclude-informational",
    "slither:report": "slither . --checklist > slither-report.md"
  }
}
