# Headers for all routes
/*
  # Enable SharedArrayBuffer for ONNX Runtime (required for VAD)
  # These headers are critical for Brave and other privacy-focused browsers
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

  # Security headers
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

  # WASM and worklet files need CORS
  Access-Control-Allow-Origin: *

# Specific headers for WASM files
/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin

# Specific headers for worklet files
/*.js
  Cross-Origin-Resource-Policy: cross-origin
